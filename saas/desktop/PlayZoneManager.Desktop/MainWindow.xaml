<Window x:Class="PlayZoneManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="PlayZone Manager"
        Width="1440" Height="900"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#07111F">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0D1B2C" BorderBrush="#1C3550" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="12,0">
                <TextBlock Text="PlayZone Manager" Foreground="#EEF6FF" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#FF8C8C" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="StatusText" Text="Connecting to Local Edge..." Foreground="#91A4BA" VerticalAlignment="Center"/>
                    <Button Content="Retry" Click="Retry_Click" Margin="12,5,0,5" Padding="12,2" Background="#15283B" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Browser" Visibility="Collapsed"/>
            <Border x:Name="OfflinePanel" Background="#07111F">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
                    <TextBlock Text="PlayZone Manager" Foreground="#EEF6FF" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="جاري الاتصال بخدمة PlayZone المحلية..." Foreground="#91A4BA" FontSize="16" Margin="0,12,0,24" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#FFB1B1" TextAlignment="Center"/>
                    <Button Content="إعادة المحاولة" Click="Retry_Click" Margin="0,20,0,0" Padding="18,10" Background="#1473E6" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
